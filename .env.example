# Dev authentication bypass — email for the seeded dev user.
# Only effective when ENABLE_DEV_AUTH=true is set in the backend .env.
# The frontend sends this via X-Development-User header in dev mode.
VITE_DEV_USER=dev@career-companion.local

# Note: the frontend uses relative /api/* paths proxied by Vite to localhost:3000.
# There is no VITE_API_URL variable — the proxy target is configured in vite.config.ts.
