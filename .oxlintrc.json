{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "ignorePatterns": ["src/routeTree.gen.ts"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "eslint/max-lines": ["warn", { "max": 500, "skipBlankLines": true, "skipComments": true }],
    "eslint/max-lines-per-function": [
      "warn",
      { "max": 80, "skipBlankLines": true, "skipComments": true }
    ],
    "eslint/complexity": ["warn", 15],
    "eslint/max-depth": ["warn", 3],
    "eslint/max-params": ["warn", 4],
    "eslint/no-nested-ternary": "warn",
    "eslint/no-console": "error"
  },
  "overrides": [
    {
      "files": ["src/tests/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "eslint/max-lines": ["warn", { "max": 800, "skipBlankLines": true, "skipComments": true }],
        "eslint/max-lines-per-function": "off",
        "eslint/complexity": "off"
      }
    },
    {
      "files": ["scripts/**", "src/components/errors/**"],
      "rules": { "eslint/no-console": "off" }
    }
  ]
}
